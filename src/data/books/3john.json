[{"id":"3joh_1_1","categoryId":"new_testament","bookId":"3john","chapter":1,"verseNum":1,"question":"மூப்பனாகிய நான் யாருக்கு இந்த நிருபத்தை எழுதுகிறேன்?","questionEn":"To whom is this epistle addressed by the elder?","options":["பிரியமுள்ள காயு என்பவருக்கு","பிரியமுள்ள சீமோன் என்பவருக்கு","பிரியமுள்ள பர்னபா என்பவருக்கு","பிரியமுள்ள அந்திரேயா என்பவருக்கு"],"optionsEn":["To the beloved Gaius","To the chosen lady","To the beloved Demetrius","To the church elders"],"correctAnswer":0,"correctAnswerEn":0,"reference":"3 யோவான் 1:1","referenceEn":"3 John 1:1","explanation":"3 யோவான் 1 அதிகாரம்","explanationEn":"3 John Chapter 1","difficulty":"medium"},{"id":"3joh_1_2","categoryId":"new_testament","bookId":"3john","chapter":1,"verseNum":2,"question":"காயுவின் ஆத்துமா வாழ்வதுபோல அவர் எப்படி இருக்கவேண்டுமென்று யோவான் வேண்டுகிறார்?","questionEn":"What does the writer pray for Gaius above all things?","options":["எல்லாவற்றிலும் பெருகியிருக்க வேண்டும்","எல்லாவற்றிலும் சுகமாயிருக்க வேண்டும்","எல்லாவற்றிலும் வாழ்ந்திருக்க வேண்டும்","எல்லாவற்றிலும் பலப்பட்டிருக்க வேண்டும்"],"optionsEn":["Prosperity and good health","Boldness and great faith","Safety and long life","Spiritual gifts and wisdom"],"correctAnswer":1,"correctAnswerEn":0,"reference":"3 யோவான் 1:2","referenceEn":"3 John 1:2","explanation":"3 யோவான் 1 அதிகாரம்","explanationEn":"3 John Chapter 1","difficulty":"medium"},{"id":"3joh_1_3","categoryId":"new_testament","bookId":"3john","chapter":1,"verseNum":3,"question":"சகோதரர் வந்து எதைக்குறித்து சாட்சி கொடுத்தார்கள்?","questionEn":"What did the brethren testify about when they came?","options":["உன்னுடைய கிருபையின் சத்தியத்தை","உன்னுடைய அன்பின் சத்தியத்தை","உன்னுடைய விசுவாச சத்தியத்தை","உன்னுடைய நீதியின் சத்தியத்தை"],"optionsEn":["The trials of Gaius","The generosity of Gaius","The truth in Gaius","The growth of Gaius"],"correctAnswer":2,"correctAnswerEn":2,"reference":"3 யோவான் 1:3","referenceEn":"3 John 1:3","explanation":"3 யோவான் 1 அதிகாரம்","explanationEn":"3 John Chapter 1","difficulty":"medium"},{"id":"3joh_1_4","categoryId":"new_testament","bookId":"3john","chapter":1,"verseNum":4,"question":"பிள்ளைகள் சத்தியத்தில் நடக்கிறதைக்கேட்கிறதைவிட எனக்கு என்ன இல்லை?","questionEn":"What brings the writer no greater joy than to hear?","options":["பெரிய மேன்மை வேறில்லை","பெரிய ஆறுதல் வேறில்லை","பெரிய பாக்கியம் வேறில்லை","பெரிய மகிழ்ச்சி வேறில்லை"],"optionsEn":["That the poor are fed","That his children walk in truth","That the gospel is preached","That the church is growing"],"correctAnswer":2,"correctAnswerEn":1,"reference":"3 யோவான் 1:4","referenceEn":"3 John 1:4","explanation":"3 யோவான் 1 அதிகாரம்","explanationEn":"3 John Chapter 1","difficulty":"medium"},{"id":"3joh_1_5","categoryId":"new_testament","bookId":"3john","chapter":1,"verseNum":5,"question":"சகோதரருக்கு நீ செய்கிற காரியம் எப்படிப்பட்டது?","questionEn":"How does Gaius act toward the brethren and strangers?","options":["அன்புள்ள கிரியையாயிருக்கிறது","கிருபையுள்ள கிரியையாயிருக்கிறது","விசுவாசமுள்ள கிரியையாயிருக்கிறது","உண்மையுள்ள கிரியையாயிருக்கிறது"],"optionsEn":["Humbly in his service","Faithfully in his deeds","Wisely and with caution","Generously with his wealth"],"correctAnswer":3,"correctAnswerEn":1,"reference":"3 யோவான் 1:5","referenceEn":"3 John 1:5","explanation":"3 யோவான் 1 அதிகாரம்","explanationEn":"3 John Chapter 1","difficulty":"medium"},{"id":"3joh_1_6","categoryId":"new_testament","bookId":"3john","chapter":1,"verseNum":6,"question":"சகோதரர் சபைக்கு முன்பாக எதைக்குறித்து சாட்சி சொன்னார்கள்?","questionEn":"Before whom did the brethren bear witness of Gaius's charity?","options":["உன்னுடைய விசுவாசத்தைக்குறித்து","உன்னுடைய நீதியைக்குறித்து","உன்னுடைய கிருபையைக்குறித்து","உன்னுடைய அன்பைக்குறித்து"],"optionsEn":["Before the church assembly","Before the Roman authorities","Before the entire city","Before the local magistrates"],"correctAnswer":3,"correctAnswerEn":0,"reference":"3 யோவான் 1:6","referenceEn":"3 John 1:6","explanation":"3 யோவான் 1 அதிகாரம்","explanationEn":"3 John Chapter 1","difficulty":"medium"},{"id":"3joh_1_7","categoryId":"new_testament","bookId":"3john","chapter":1,"verseNum":7,"question":"அவர்கள் எதினிமித்தம் புறப்பட்டார்கள்?","questionEn":"From whom did those who went forth take nothing?","options":["அவருடைய நீதியினிமித்தம்","அவருடைய கிருபையினிமித்தம்","அவருடைய நாமத்தினிமித்தம்","அவருடைய மகிமையினிமித்தம்"],"optionsEn":["From the Jerusalem church","From the Roman government","From the local synagogue","From the Gentile unbelievers"],"correctAnswer":2,"correctAnswerEn":3,"reference":"3 யோவான் 1:7","referenceEn":"3 John 1:7","explanation":"3 யோவான் 1 அதிகாரம்","explanationEn":"3 John Chapter 1","difficulty":"medium"},{"id":"3joh_1_8","categoryId":"new_testament","bookId":"3john","chapter":1,"verseNum":8,"question":"நாம் அவர்களுக்கு எதைச் செய்யக் கடனாளிகளாயிருக்கிறோம்?","questionEn":"Why ought we to receive such fellow helpers?","options":["உதவி செய்யக் கடனாளிகள்","உபசரிப்பு செய்யக் கடனாளிகள்","அன்பு செய்யக் கடனாளிகள்","ஆதரவு செய்யக் கடனாளிகள்"],"optionsEn":["To avoid public condemnation","To show Christian hospitality","To spread our own reputation","To be fellow helpers to the truth"],"correctAnswer":1,"correctAnswerEn":3,"reference":"3 யோவான் 1:8","referenceEn":"3 John 1:8","explanation":"3 யோவான் 1 அதிகாரம்","explanationEn":"3 John Chapter 1","difficulty":"medium"},{"id":"3joh_1_9","categoryId":"new_testament","bookId":"3john","chapter":1,"verseNum":9,"question":"சபையிலே முதன்மையாயிருக்க விரும்புகிறவர் யார்?","questionEn":"Who loves to have the preeminence among them but does not receive the writer?","options":["தீத்து என்பவன்","தியோத்திரேப்பு என்பவன்","திமொத்தேயு என்பவன்","திக்கிக்கு என்பவன்"],"optionsEn":["Diotrephes the proud","Demetrius the silversmith","Philetus the false teacher","Alexander the coppersmith"],"correctAnswer":1,"correctAnswerEn":0,"reference":"3 யோவான் 1:9","referenceEn":"3 John 1:9","explanation":"3 யோவான் 1 அதிகாரம்","explanationEn":"3 John Chapter 1","difficulty":"medium"},{"id":"3joh_1_10","categoryId":"new_testament","bookId":"3john","chapter":1,"verseNum":10,"question":"தியோத்திரேப்பு எதைச் செய்கிறான் என்று யோவான் கூறுகிறார்?","questionEn":"With what kind of words does Diotrephes prate against the writer?","options":["வீணான வார்த்தைகளைப் பேசுகிறான்","பொல்லாத வார்த்தைகளைப் பேசுகிறான்","கடினமான வார்த்தைகளைப் பேசுகிறான்","கசப்பான வார்த்தைகளைப் பேசுகிறான்"],"optionsEn":["Flattering and deceitful words","Foolish and ignorant words","Angry and threatening words","Malicious and empty words"],"correctAnswer":1,"correctAnswerEn":3,"reference":"3 யோவான் 1:10","referenceEn":"3 John 1:10","explanation":"3 யோவான் 1 அதிகாரம்","explanationEn":"3 John Chapter 1","difficulty":"medium"},{"id":"3joh_1_11","categoryId":"new_testament","bookId":"3john","chapter":1,"verseNum":11,"question":"நன்மையைச் செய்கிறவன் எதிலிருந்து உண்டானவன்?","questionEn":"What instruction is given regarding what to follow?","options":["தேவனிடத்திலிருந்து உண்டானவன்","சத்தியத்தினிடத்திலிருந்து உண்டானவன்","கிறிஸ்துவிடத்திலிருந்து உண்டானவன்","ஆவியினிடத்திலிருந்து உண்டானவன்"],"optionsEn":["Follow not that which is evil","Follow the traditions of elders","Follow the signs and wonders","Follow the laws of Moses"],"correctAnswer":0,"correctAnswerEn":0,"reference":"3 யோவான் 1:11","referenceEn":"3 John 1:11","explanation":"3 யோவான் 1 அதிகாரம்","explanationEn":"3 John Chapter 1","difficulty":"medium"},{"id":"3joh_1_12","categoryId":"new_testament","bookId":"3john","chapter":1,"verseNum":12,"question":"எல்லாராலும் சாட்சிபெற்றவர் யார்?","questionEn":"Who has a good report of all men and of the truth itself?","options":["தியோத்திரேப்பு என்பவன்","தீமோத்தேயு என்பவன்","திக்கிக்கு என்பவன்","தமேத்திரியு என்பவன்"],"optionsEn":["Stephanas the minister","Diotrephes the leader","Demetrius the faithful","Gaius the beloved"],"correctAnswer":3,"correctAnswerEn":2,"reference":"3 யோவான் 1:12","referenceEn":"3 John 1:12","explanation":"3 யோவான் 1 அதிகாரம்","explanationEn":"3 John Chapter 1","difficulty":"medium"},{"id":"3joh_1_13","categoryId":"new_testament","bookId":"3john","chapter":1,"verseNum":13,"question":"உனக்கு எழுதவேண்டிய காரியங்கள் அநேகம் உண்டு, ஆனால் நான் எதைக்கொண்டு எழுதமாட்டேன்?","questionEn":"With what does the writer not wish to write to Gaius?","options":["எழுத்தினாலும் காகிதத்தினாலும்","மைத்தினாலும் எழுதுகோலினாலும்","மசியினாலும் இறகினாலும்","காகிதத்தினாலும் பேனாவினாலும்"],"optionsEn":["Tablets and a stylus","Paper and charcoal","Ink and a pen","Parchment and expensive ink"],"correctAnswer":1,"correctAnswerEn":2,"reference":"3 யோவான் 1:13","referenceEn":"3 John 1:13","explanation":"3 யோவான் 1 அதிகாரம்","explanationEn":"3 John Chapter 1","difficulty":"medium"},{"id":"3joh_1_14","categoryId":"new_testament","bookId":"3john","chapter":1,"verseNum":14,"question":"உன்னை நேரில் எப்போது பார்க்க விரும்புகிறேன்?","questionEn":"How does the writer trust he shall see Gaius shortly?","options":["விரைவில் பார்க்க விரும்புகிறேன்","விரைவில் சந்திக்க விரும்புகிறேன்","அண்மையில் பார்க்க விரும்புகிறேன்","சீக்கிரத்தில் பார்க்க விரும்புகிறேன்"],"optionsEn":["In the spirit","At the feast","In the temple","Face to face"],"correctAnswer":3,"correctAnswerEn":3,"reference":"3 யோவான் 1:14","referenceEn":"3 John 1:14","explanation":"3 யோவான் 1 அதிகாரம்","explanationEn":"3 John Chapter 1","difficulty":"medium"},{"id":"3joh_1_15","categoryId":"new_testament","bookId":"3john","chapter":1,"verseNum":15,"question":"நண்பர்கள் உனக்கு வாழ்த்துதல் சொல்லுகிறார்கள், நீயும் நண்பர்களுக்கு எதைச் சொல்?","questionEn":"நண்பர்கள் உனக்கு வாழ்த்துதல் சொல்லுகிறார்கள், நீயும் நண்பர்களுக்கு எதைச் சொல்?","options":["அன்பாக வாழ்த்துதல் சொல்","பேர்பேராக வாழ்த்துதல் சொல்","நேராக வாழ்த்துதல் சொல்","ஒவ்வொன்றாக வாழ்த்துதல் சொல்"],"optionsEn":["அன்பாக வாழ்த்துதல் சொல்","பேர்பேராக வாழ்த்துதல் சொல்","நேராக வாழ்த்துதல் சொல்","ஒவ்வொன்றாக வாழ்த்துதல் சொல்"],"correctAnswer":1,"correctAnswerEn":1,"reference":"3 யோவான் 1:15","referenceEn":"3 John 1:15","explanation":"3 யோவான் 1 அதிகாரம்","explanationEn":"3 John Chapter 1","difficulty":"medium"}]