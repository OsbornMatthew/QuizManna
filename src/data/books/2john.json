[{"id":"2joh_1_1","categoryId":"new_testament","bookId":"2john","chapter":1,"verseNum":1,"question":"மூப்பர் யாருக்கு இந்த நிருபத்தை எழுதுகிறார்?","questionEn":"To whom does the elder address this letter?","options":["தெரிந்துகொள்ளப்பட்ட சத்தியத்தின் சபைக்கு","தெரிந்துகொள்ளப்பட்ட சீஷனின் மனைவிக்கு","தெரிந்துகொள்ளப்பட்ட பிரபுவின் மனைவிக்கு","தெரிந்துகொள்ளப்பட்ட தாயின் பிள்ளைகளுக்கு"],"optionsEn":["The beloved Gaius","The elect lady","The holy brethren","The church in Ephesus"],"correctAnswer":3,"correctAnswerEn":1,"reference":"2 யோவான் 1:1","referenceEn":"2 John 1:1","explanation":"2 யோவான் 1 அதிகாரம்","explanationEn":"2 John Chapter 1","difficulty":"medium"},{"id":"2joh_1_2","categoryId":"new_testament","bookId":"2john","chapter":1,"verseNum":2,"question":"சத்தியம் நம்முள் நிலைத்திருப்பது எதனால்?","questionEn":"Where does the truth dwell and abide according to John?","options":["நம்முடன் தங்கியிருக்கும் கிருபையினால்","நம்முடன் தங்கியிருக்கும் அன்பினால்","நம்முடன் தங்கியிருக்கும் விசுவாசத்தால்","நம்முடன் தங்கியிருக்கும் சத்தியத்தினால்"],"optionsEn":["In the scriptures","In the temple","In us forever","In heaven forever"],"correctAnswer":3,"correctAnswerEn":2,"reference":"2 யோவான் 1:2","referenceEn":"2 John 1:2","explanation":"2 யோவான் 1 அதிகாரம்","explanationEn":"2 John Chapter 1","difficulty":"medium"},{"id":"2joh_1_3","categoryId":"new_testament","bookId":"2john","chapter":1,"verseNum":3,"question":"நமக்குக் கிருபையும் சமாதானமும் யாரிடமிருந்து வரும்?","questionEn":"In what two qualities will grace, mercy, and peace be with believers?","options":["பிதாவாகிய தேவனும் இயேசுவும்","பிதாவாகிய தேவனும் ஆவியும்","பிதாவாகிய தேவனும் கர்த்தரும்","பிதாவாகிய தேவனும் தூதரும்"],"optionsEn":["Faith and hope","Patience and meekness","Truth and love","Righteousness and joy"],"correctAnswer":2,"correctAnswerEn":2,"reference":"2 யோவான் 1:3","referenceEn":"2 John 1:3","explanation":"2 யோவான் 1 அதிகாரம்","explanationEn":"2 John Chapter 1","difficulty":"medium"},{"id":"2joh_1_4","categoryI