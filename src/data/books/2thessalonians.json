rectAnswer":0,"correctAnswerEn":1,"reference":"2 தெசலோனிக்கேயர் 2:17","referenceEn":"2 Thessalonians 2:17","explanation":"2 தெசலோனிக்கேயர் 2 அதிகாரம்","explanationEn":"2 Thessalonians Chapter 2","difficulty":"medium"},{"id":"2the_3_1","categoryId":"new_testament","bookId":"2thessalonians","chapter":3,"verseNum":1,"question":"பவுல் எதற்காகத் தங்களுக்கு ஜெபம் பண்ணும்படி வேண்டுகிறார்?","questionEn":"What did Paul ask the believers to pray for regarding the word of the Lord?","options":["சபையின் ஐக்கியம் வளர்வதற்கு","கர்த்தருடைய வசனம் பரவுவதற்கு","விசுவாசிகள் பலன் அடைவதற்கு","துன்பங்கள் நீங்கிப் போவதற்கு"],"optionsEn":["That it may be silenced","That it may spread rapidly","That it may remain hidden","That it may be forgotten"],"correctAnswer":1,"correctAnswerEn":1,"reference":"2 தெசலோனிக்கேயர் 3:1","referenceEn":"2 Thessalonians 3:1","explanation":"2 தெசலோனிக்கேயர் 3 அதிகாரம்","explanationEn":"2 Thessalonians Chapter 3","difficulty":"medium"},{"id":"2the_3_2","categoryId":"new_testament","bookId":"2thessalonians","chapter":3,"verseNum":2,"question":"எல்லா மனுஷருக்கும் இல்லாதது எது?","questionEn":"From what kind of people did Paul ask to be delivered?","options":["விசுவாசம் என்னும் ஈவு","கர்த்தருடைய பரிசுத்த அன்பு","தேவனுடைய கிருபையின் வரம்","நித்திய ஜீவனின் நம்பிக்கை"],"optionsEn":["The weak and timid","The wicked and evil","The young and foolish","The rich and powerful"],"correctAnswer":0,"correctAnswerEn":1,"reference":"2 தெசலோனிக்கேயர் 3:2","referenceEn":"2 Thessalonians 3:2","explanation":"2 தெசலோனிக்கேயர் 3 அதிகாரம்","explanationEn":"2 Thessalonians Chapter 3","difficulty":"medium"},{"id":"2the_3_3","categoryId":"new_testament","bookId":"2thessalonians","chapter":3,"verseNum":3,"question":"கர்த்தர் விசுவாசிகளை எதிலிருந்து காப்பார்?","questionEn":"Who is faithful and will strengthen and protect the believers?","options":["பொல்லாங்கன் என்னும் சாத்தான்","உலகத்தின் தீய வழிகள்","மனிதர்களின் கசப்பான சொற்கள்","சரீரத்தின் பலவீனமான நோய்கள்"],"optionsEn":["The Roman authorities","The local elders","The apostles","The Lord"],"correctAnswer":0,"correctAnswerEn":3,"reference":"2 தெசலோனிக்கேயர் 3:3","referenceEn":"2 Thessalonians 3:3","explanation":"2 தெசலோனிக்கேயர் 3 அதிகாரம்","explanationEn":"2 Thessalonians Chapter 3","difficulty":"medium"},{"id":"2the_3_4","categoryId":"new_testament","bookId":"2thessalonians","chapter":3,"verseNum":4,"question":"பவுல் எதைக்குறித்து நம்பிக்கையுள்ளவராயிருக்கிறார்?","questionEn":"What confidence did Paul have regarding the believers?","options":["நீங்கள் கட்டளைகளைக் கைக்கொள்வீர்கள்","தேவன் உங்களை வழிநடத்துவார்","கர்த்தர் சபையை ஆசீர்வதிப்பார்","விசுவாசம் பெருகி வளரும்"],"optionsEn":["They were doing what commanded","They were seeking new teachers","They were doubting the truth","They were leaving the city"],"correctAnswer":0,"correctAnswerEn":0,"reference":"2 தெசலோனிக்கேயர் 3:4","referenceEn":"2 Thessalonians 3:4","explanation":"2 தெசலோனிக்கேயர் 3 அதிகாரம்","explanationEn":"2 Thessalonians Chapter 3","difficulty":"medium"},{"id":"2the_3_5","categoryId":"new_testament","bookId":"2thessalonians","chapter":3,"verseNum":5,"question":"கர்த்தர் உங்கள் இருதயங்களை எதில் வழிநடத்த வேண்டும்?","questionEn":"Into what did Paul pray the Lord would direct their hearts?","options":["கிருபையின் வழியிலும் சமாதானத்திலும்","பரிசுத்த ஆவியின் வல்லமையிலும்","கிறிஸ்துவின் நீதியிலும் சத்தியத்திலும்","தேவனுடைய அன்பிலும் பொறுமையிலும்"],"optionsEn":["Worldly wealth and earthly power","God’s love and Christ’s perseverance","Human wisdom and social status","Personal comfort and physical safety"],"correctAnswer":3,"correctAnswerEn":1,"reference":"2 தெசலோனிக்கேயர் 3:5","referenceEn":"2 Thessalonians 3:5","explanation":"2 தெசலோனிக்கேயர் 3 அதிகாரம்","explanationEn":"2 Thessalonians Chapter 3","difficulty":"medium"},{"id":"2the_3_6","categoryId":"new_testament","bookId":"2thessalonians","chapter":3,"verseNum":6,"question":"எந்த சகோதரனை விட்டு விலகியிருக்க வேண்டும்?","questionEn":"What should believers do regarding brothers who are idle?",